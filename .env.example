# Ambiente — PedidoMesa (exemplo)
# Copie para .env e ajuste. NUNCA versionar o .env real.

# Postgres (Docker Compose)
POSTGRES_USER=pedidomesa
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=pedidomesa
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL usada pela API dentro do Compose
DATABASE_URL=postgresql+psycopg://pedidomesa:troque_esta_senha@db:5432/pedidomesa

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Auth demo (placeholder — trocar em produção)
DEMO_ESTABELECIMENTO_USER=demo
DEMO_ESTABELECIMENTO_PASS=demo123
DEMO_TOKEN_SECRET=troque_este_segredo_local

# Web
# URL da API acessível pelo NAVEGADOR do cliente (não pelo Docker network).
# Em produção: https://api.SEUDOMINIO.com.br (ou o mesmo domínio com /api via proxy).
# Atenção: é inlinada no bundle em BUILD-TIME (ver web/Dockerfile) — trocar exige rebuild da imagem web.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública do site, usada para montar o link/QR de cada mesa (ex.: https://pedidomesa.tech42.com.br).
# Se vazia, o QR cai no window.location.origin do navegador que gerou o QR — pode ficar errado
# se gerado a partir de localhost. Defina sempre em produção. Também inlinada em BUILD-TIME.
NEXT_PUBLIC_APP_URL=http://localhost:3000
